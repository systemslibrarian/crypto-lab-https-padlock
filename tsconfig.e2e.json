{
  /* The e2e project, typechecked separately from src/.
   *
   * e2e/contrast.ts and e2e/nontext.ts are copied from
   * crypto-lab-schnorr-forge, which the master template names as the one lab
   * verified clean on every known oracle defect. They are ~1460 lines of
   * measured colour arithmetic, and they were written against a tsconfig
   * without `noUncheckedIndexedAccess`.
   *
   * That flag stays ON for src/ in tsconfig.json, where it catches real bugs
   * in code written here. It is OFF for this project rather than rewriting 84
   * index accesses inside a verified oracle -- an edit with no upside and a
   * real chance of introducing the kind of defect those oracles exist to
   * catch. Nothing about the gate itself is relaxed: the same axe runs, the
   * same arithmetic, the same ratchet.
   *
   * Everything else stays strict, so the specs written in THIS repo --
   * a11y.spec.ts, claims.spec.ts, verdict-coverage.spec.ts, gate.ts and the
   * observation plumbing -- are still fully checked, and `npm run build` fails
   * on a type error in any of them.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": ["e2e"]
}
